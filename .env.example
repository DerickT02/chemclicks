# Copy to `.env.local` and fill in values from your Supabase project:
# Dashboard → Project Settings → API

# Public (safe to expose in the browser; used by `@supabase/ssr` / client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only; used to validate student credentials and provision hidden Auth identities.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Add this exact redirect in Supabase → Authentication → URL Configuration → Redirect URLs:
# http://localhost:3000/auth/callback

# Vitest database tests (`npm test`) use the same service role key.
# You may instead put test credentials in `.env.test.local` (gitignored).

